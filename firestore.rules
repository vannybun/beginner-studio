rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Beginner English Studio: schools/{secret school code}/kv/{key}
    match /schools/{school}/kv/{key} {
      allow read, write: if request.auth != null && school.size() >= 20;
    }
    // 💬 realtime: presence, friends, chat (schools/{school}/live/...)
    match /schools/{school}/live/{doc=**} {
      allow read, write: if request.auth != null && school.size() >= 20;
    }
    // 6-character class codes -> school (get only, no listing; create once)
    match /codes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && code.size() == 6
                    && request.resource.data.s is string && request.resource.data.s.size() >= 20;
    }
  }
}
